# Обязательные
TELEGRAM_BOT_TOKEN=          # токен из @BotFather
ANTHROPIC_API_KEY=           # ключ API Claude
ALLOWED_TELEGRAM_USER_ID=    # твой ID (команда /myid у бота)
# Vault (закрытый репозиторий)
VAULT_REPO=                  # owner/name
GITHUB_TOKEN=                # fine-grained токен: доступ только к репозиторию vault, Contents: read/write
# Необязательные
MODEL=claude-sonnet-5-5
VAULT_DIR=/data/vault
DAILY_MESSAGE_CAP=200
TZ_OFFSET_HOURS=5
